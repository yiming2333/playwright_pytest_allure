# 使用和测试容器相同的基础镜像（保持环境一致）
FROM python:3.12-alpine
WORKDIR /app
RUN apk add --no-cache curl

RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple flask==3.1.3
# 复制所有项目文件（包括 mock_server.py, templates 等）
COPY mock_server.py .
COPY templates templates/
# 暴露 Flask 默认端口
EXPOSE 5000

# 启动 Mock Server（假设你的入口文件是 mock_server.py，里面有 app.run()）
CMD ["python", "mock_server.py"]