# ===== 被测应用 =====
# BASE_URL=http://127.0.0.1:5000

# ===== 浏览器配置 =====
# BROWSER=chromium          # chromium / firefox / webkit
# HEADLESS=true             # CI 用 true，本地调试改 false
# SLOW_MO=0                # 调试时设 100 让操作慢放
# VIEWPORT_WIDTH=1280
# VIEWPORT_HEIGHT=720

# ===== 超时（毫秒）=====
# DEFAULT_TIMEOUT=30000
# NAV_TIMEOUT=30000

# ===== 并发与重试 =====
# PARALLEL_WORKERS=auto     # 数字或 auto
# RERUNS=0                  # 失败重试次数

# ===== 日志 =====
# LOG_LEVEL=INFO            # DEBUG / INFO / WARNING / ERROR
# LOG_DIR=logs

# ===== 测试账号（敏感信息，生产环境务必从 CI Secret 注入）=====
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
# EDITOR_USERNAME=editor
# EDITOR_PASSWORD=edit456
# VIEWER_USERNAME=viewer
# VIEWER_PASSWORD=view789
